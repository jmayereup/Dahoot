# PocketBase Connection Settings
VITE_POCKETBASE_URL=http://localhost:8090
VITE_POCKETBASE_LIVE_URL=https://your-production-pocketbase-url.com

# PocketBase Superuser Credentials (used for programmatic schema migrations and database setup)
POCKETBASE_ADMIN_EMAIL=admin@yourdomain.com
POCKETBASE_ADMIN_PASSWORD=your-secure-admin-password-here

# School domain for admin user creation (e.g., dahoot@yourschool.com)
SCHOOL_EMAIL_DOMAIN=your-school-domain.com

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=minimax/minimax-m3

# Deployment Settings
DEPLOY_SERVER_IP=your-server-ip
DEPLOY_SERVER_USER=root
DEPLOY_SERVER_PATH=/opt/dahoot/
DEPLOY_SERVICE_NAME=dahoot.service
# Path to the shared PocketBase pb_hooks directory on the live server (may differ from DEPLOY_SERVER_PATH)
POCKETBASE_HOOKS_PATH=/opt/pocketbase/pb_hooks
# Path to the PocketBase executable binary on the live server (automatically derived from POCKETBASE_HOOKS_PATH if omitted)
# DEPLOY_POCKETBASE_PATH=/opt/pocketbase/pocketbase
